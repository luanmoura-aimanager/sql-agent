# Copia esse arquivo pra .env e ajusta os valores. .env NÃO entra no git
# (já está no .gitignore — checar antes de commitar segredo).

# Bearer token esperado pela API. Em prod, gerado por secret manager.
API_TOKEN=dev-token-trocar-em-prod

# Postgres connection string. Formato:
#   postgresql+asyncpg://USER:PASS@HOST:PORT/DB
#
# - "postgresql+asyncpg" é o dialect do SQLAlchemy pra async via asyncpg.
#   "postgresql://" sozinho viraria psycopg2 sync — não é o que queremos.
# - Default casa com o docker-compose.yml local.
# - Em prod, vem de secret manager (variavel injetada pelo runtime).
DATABASE_URL=postgresql+asyncpg://sql_agent:sql_agent_dev@localhost:5432/sql_agent

# (Opcional) Lista de IPs/CIDRs separados por vírgula. XFF só é confiado
# quando o peer está nessa lista. Vazio = comportamento antigo (peer IP).
# Ver main.py comentário do get_client_ip pra explicação.
# TRUSTED_PROXIES=

# (Opcional) Nível de log. INFO em prod, DEBUG em incident response.
# Implementado em logging_config.py via setup_logging(level=...).
# LOG_LEVEL=INFO
